# ============================================================
# netagent — configuracao do backend (copie para .env)
# NUNCA commitar o .env real (contem a senha da API dos MKs)
# ============================================================

# --- Roteadores (RouterOS api-ssl, ver router-scripts/setup-netagent-*.rsc)
MK_A_HOST=10.2.2.1          # MK-A "hEX" Casa Mae (tb acessivel via 172.20.20.1)
MK_B_HOST=10.3.3.1          # MK-B "house-b" Casa User (tb 172.20.20.2)
ROS_USER=netagent
ROS_PASS=troque-esta-senha     # senha criada pelo setup-netagent-*.rsc
ROS_PORT=8729
ROS_USE_SSL=true
ROS_SSL_VERIFY=false           # cert auto-assinado do roteador
ROS_CONNECT_TIMEOUT=5

# --- Alertas (barramento ntfy existente — POST texto puro, sem auth)
NTFY_URL=https://ntfy.example.com/alertas
NTFY_ENABLED=true            # false desliga TODO push ntfy do backend
NTFY_MIN_SEVERITY=warning    # piso p/ regras sem flag notify propria

# --- Poller
POLL_INTERVAL=3                # segundos entre ciclos de coleta
PING_COUNT=3                   # pings p/ medir RTT do gateway de cada WAN

# --- Storage
DB_PATH=/opt/netagent/netagent.db
SAMPLE_RETENTION_HOURS=24      # samples crus
ROLLUP_RETENTION_DAYS=30       # rollups de 1 minuto

# --- Agente
AGENT_READ_ONLY=false          # true = kill-switch ligado ja no boot
ALERT_DEDUP_MINUTES=10         # janela de dedup por chave de alerta
# Kinds liberados p/ execucao autonoma do agente (csv). Vazio = tudo manual.
# Opcoes: force_host_via_link,adjust_sqm_limit,toggle_route
ACTION_ALLOWLIST=

# --- Coletor IPFIX (traffic-flow target apontado pelo .rsc)
IPFIX_LISTEN_HOST=0.0.0.0
IPFIX_LISTEN_PORT=2055

# --- Wi-Fi (AP Tenda RX2 Pro na LAN da Casa User)
TENDA_HOST=10.3.3.178
TENDA_PASS=                 # senha admin do webui; vazio = so probe sem login
WIFI_POLL_INTERVAL=15       # segundos entre consultas ao Tenda

# --- Agente de IA (Fase 3 — Claude/Anthropic via httpx puro)
ANTHROPIC_API_KEY=             # vazio = agente idle (nenhuma chamada sai)
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_INTERVAL_S=300           # segundos entre ciclos de analise
AGENT_ENABLED=true             # false desliga o loop de analise
